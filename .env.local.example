# Copiar este archivo a .env.local en tu PC (no subir a git).
# Solo afecta pruebas locales; el servidor de producción usa .env sin cambios.

# Puerto distinto al servidor (5000) para no chocar en la misma máquina
FLASK_PORT=5002

# Base de datos: localhost o IP del MySQL del servidor si quieres los mismos datos
# MYSQL_HOST=127.0.0.1
# MYSQL_HOST=192.168.20.205
# MYSQL_USER=root
# MYSQL_PASSWORD=tu_clave
# MYSQL_DATABASE=gestio_humana

# Enlaces externos (opcional). Si no los pones, se mantiene 192.168.20.205
# PORTAL_COLBEEF_URL=http://192.168.20.205:8000/site.html
# GESTOR_CONTRATACION_PORTAL_URL=http://192.168.20.205:5001/acceso-integrado

# Desactivar correos en local
# MAIL_ENABLED=0
